-- group by e having: agrupa os registros por uma ou mais colunas e permite filtrar os grupos com base em uma condicao
-- quantos alunos estao matriculados em cada turma
SELECT
    Turma,
    COUNT(*) AS QuantidadeDeAlunos
FROM
    Alunos
GROUP BY
    Turma
GROUP BY
    QuantidadeDeAlunos DESC;

-- ordena o resultado pela quantidade de matriculas em ordem decrescente
-- cursos que tem 2 ou mais matriculas
SELECT
    IdCurso,
    COUNT(*) AS QuantidadeDeMatriculas
FROM
    Matriculas
GROUP BY
    IdCurso
HAVING
    COUNT(*) >= 2 -- filtra os cursos que tem duas ou mais matriculas
ORDER BY
    QuantidadeDeMatriculas DESC;
    
-- inner join: retorna apenas os registros que tem correspondecia em ambas as tabelas
SELECT
    -- 1 passo, definir os dados que serao mostrados e como serao mostrados
    a.Nome AS NomeDoAluno,
    c.NomeCurso AS NomeDoCurso,
    m.NotaFinal,
    m.StatusMatricula -- 2 passo, cruzar dados
FROM
    Matriculas AS m
    INNER JOIN Alunos AS a ON m.IdAluno = a.IdAluno -- relaciona a tabela matriculas com a tabela alunos
    INNER JOIN Cursos AS c ON m.IdCurso = c.IdCurso -- relaciona a tabela matriculas com a tabela cursos
    -- 3 passom, como resultado sera organizado
ORDER BY
    a.Nome -- ordena o resultado pelo nome do aluno

-- join com 4 tabelas
SELECT
    a.Nome AS Aluno,
    a.Turma,
    c.NomeCurso AS Curso,
    p.Nome AS Professor,
    m.NotaFinal,
    m.StatusMatricula
FROM
    Matriculas AS m
    INNER JOIN Alunos AS a ON m.IdAluno = a.IdAluno
    INNER JOIN Cursos AS c ON m.IdCurso = c.idCurso
    INNER JOIN Professores AS p ON c.IdProfessor = p.IdProfessor
ORDER BY
    p.Nome,
    c.NomeCurso,
    a.Nome


SELECT
    a.Nome AS NomeDoAluno,
    c.NomeCurso AS NomeDoCurso,
    m.NotaFinal,
    m.StatusMatricula
FROM
    Alunos AS a
    LEFT JOIN Matriculas AS m ON a.IdAluno = m.IdAluno
    LEFT JOIN Cursos AS c ON m.IdCurso = c.IdCurso
WHERE
    m.IdMatricula IS NULL 
    
-- join com filtro e media por curso. retorna a media das notas finais por curso considerando apenas os alunos que possuem matricula
SELECT
    c.NomeCurso AS Curso,
    COUNT(m.IdMatricula) AS TotalDeMatriculas,
    AVG(m.NotaFinal) AS MediaDoCurso
FROM
    Cursos AS c
    LEFT JOIN Matriculas AS m ON c.IdCurso = m.IdCurso
WHERE
    m.NotaFinal IS NOT NULL
GROUP BY
    c.NomeCurso
ORDER BY
    c.NomeCurso