    TOP 5 Nome,
    Turma,
    DataNascimento
FROM
    Alunos
ORDER BY
    Nome;

select
    *
from
    Alunos;

-- filtros com where
-- where filtra as linhas. leia a consulta como uma frase: "selecione os nomes e turmas dos alunos onde a turma seja igual a '2INFO-A'""
-- igual a
SELECT
    Nome,
    Turma
FROM
    Alunos
WHERE
    Turma = '2INFO-A';

-- diferente de
SELECT
    Nome,
    Turma
FROM
    Alunos
WHERE
    Turma <> '2INFO-A';

-- and: as duas condiçoes devem  ser verdadeiras para que o registro seja retornado na consulta
SELECT
    Nome,
    Turma,
    DataNascimento
FROM
    Alunos
WHERE
    Turma = '2INFO-A'
    AND DataNascimento > '2008-01-01';

-- > = maior
-- or: pelo menos uma condicao precisa ser verdadeira
SELECT
    Nome,
    Turma
FROM
    Alunos
WHERE
    Turma = '2INFO-A'
    OR DataNascimento > '2008-01-01';

-- in: versao mais curta para varios valores
SELECT
    Nome,
    Turma
FROM
    Alunos
WHERE
    Turma IN ('2INFO-A', '2INFO-B');

-- ou seja, selecione os nomes e turmas dos alunos onde a turma seja igual a '2INFO-A' ou '2INFO-B'
-- like: % significa 'qualquer quantidade de caracteres' e _ significa qualquer caractere
SELECT
    Nome,
    Email
FROM
    Alunos
WHERE
    Nome LIKE '%es' -- ou seja, selecione os nomes e emails dos alunos onde o email termina com '@escola.com'